# Copy this to .env and fill in your values.
# Never commit .env to git.

# PostgreSQL connection string
# Local: postgresql://postgres:password@localhost:5432/retail_analytics
# Hosted: get this from your provider (Railway, Supabase, Neon, etc.)
DATABASE_URL=postgresql://postgres:password@localhost:5432/retail_analytics

# JWT secret — generate a strong random string for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_something_long_and_random_right_now
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# File upload limits
# XLSX workbooks are read into memory by SheetJS, so this cap is the real
# guard rail for workbook size. CSV files are streamed row by row. Default: 60
MAX_FILE_SIZE_MB=60
UPLOAD_TEMP_DIR=./uploads/temp

# Share of the unit price used as the unit cost when an uploaded file has no cost
# column (0–1). Imports report the estimate rather than hiding it. Default: 0.6
# COST_RATIO_DEFAULT=0.6

# CORS: comma-separated list of allowed frontend origins (Vercel URL in production)
# e.g. CORS_ORIGIN=http://localhost:5173,https://retail-analytics-saas.vercel.app
CORS_ORIGIN=http://localhost:5173
