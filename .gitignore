# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local env files — the templates (.env.example, backend/.env.example) stay committed
.env
.env.local

# Runtime upload scratch space, created on boot by backend/src/routes/upload.js.
# Not needed in git: the server mkdir -p's it.
backend/uploads/

# Generated benchmark CSVs. A bench run writes them into the OS temp dir; this
# pattern keeps a run from a repo checkout from dirtying the tree. The published
# reports under docs/validation/ are committed on purpose.
bench_*.csv

# Second demo tenant's datasets. The raw export lives outside the repository; the
# prepared CSVs are regenerated on demand by backend/scripts/bakery/prepareData.js
# (npm run --prefix backend bakery:prepare) and the catalogue by its seed step.
# Committed instead: docs/data/london_bakers_provenance.md, which records exactly
# which source files, columns and assumptions produced them.
data/raw/
data/processed/

# Local agent / editor tooling — not part of the application
.claude/
.github/hooks/
