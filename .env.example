# Frontend environment template for the Retail Analytics dashboard.
# Local dev:  copy to .env (gitignored) and adjust as needed.
# Production: set these in Vercel → Project Settings → Environment Variables
#             BEFORE building (VITE_* variables are inlined at build time).

# Base URL of the Retail Analytics Express API.
#   Local:  http://localhost:3001
#   Hosted: e.g. https://your-backend.up.railway.app
# The backend must also allow this frontend's origin in its CORS_ORIGIN env var.
VITE_API_URL=http://localhost:3001

# ── Optional demo conveniences ────────────────────────────────────────────────
# Both are OFF unless set. VITE_DEMO_* values are inlined at build time, so never
# put a real production credential here.

# Show "Quick sign-in" role chips on the sign-in screen for the selected demo
# store (labels + emails come from src/config/demoTenants.js).
# VITE_DEMO_MODE=true

# Password the quick sign-in chips fill in. Leave it out and the chips fill the
# email only, so the presenter types the password by hand.
# VITE_DEMO_PASSWORD=Demo@1234
